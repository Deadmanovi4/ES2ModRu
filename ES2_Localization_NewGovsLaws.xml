    <!--Monarch-->
    <LocalizationPair Name="%GovernmentMonarchyTitle">Constitutional</LocalizationPair>
    <LocalizationPair Name="%GovernmentMonarchyDescription">A government in which the Head of State exercises authority in accordance with a written constitution.</LocalizationPair>
    <LocalizationPair Name="%GovernmentMonarchyFormat">The United Systems of {0}</LocalizationPair>
    
    <!--Police-->
    <LocalizationPair Name="%GovernmentPoliceTitle">Authoritarian</LocalizationPair>
    <LocalizationPair Name="%GovernmentPoliceDescription">Authoritarian government is a form of government by a strong central power that values order and control over political freedoms.</LocalizationPair>
    <LocalizationPair Name="%GovernmentPoliceFormat">The Galactic Order of {0}</LocalizationPair>
    
    <!--Corp-->
    <LocalizationPair Name="%GovernmentCorpTitle">Corporate Empire</LocalizationPair>
    <LocalizationPair Name="%GovernmentCorpDescription">A corporate empire is a government that is rule by a corporation, whose power is expanded by the market.</LocalizationPair>
    <LocalizationPair Name="%GovernmentCorpFormat">{0} Intergalactic Corporation</LocalizationPair>
    
    <!--Military-->
    <LocalizationPair Name="%GovernmentMilitaryTitle">Stratocracy</LocalizationPair>
    <LocalizationPair Name="%GovernmentMilitaryDescription">A form of military government in which civil and military service are indistinguishable, where the state and the military are traditionally or constitutionally the same entity.</LocalizationPair>
    <LocalizationPair Name="%GovernmentMilitaryFormat">The Galactic Union of {0}</LocalizationPair>
    
    <!--Techno-->
    <LocalizationPair Name="%GovernmentTechnoTitle">Technocracy</LocalizationPair>
    <LocalizationPair Name="%GovernmentTechnoDescription">A government ruled by the educated and technical experts, where decision makers are selected based upon how knowledgeable and skillful they are in their field, no matter their political affiliation.</LocalizationPair>
    <LocalizationPair Name="%GovernmentTechnoFormat">The Directorate of {0}</LocalizationPair>
    
    <!--TooltipOverride-->
    <LocalizationPair Name="%police">Rebellions Progress 50% Faster</LocalizationPair>
    <LocalizationPair Name="%upkeep">Law Upkeep is FREE.</LocalizationPair>
    <LocalizationPair Name="%colonization">Colonization is UNLIMITED.</LocalizationPair>
    <LocalizationPair Name="%norep">No penalty for No Representation in Senate</LocalizationPair>
