    <!--Police-->
    <LocalizationPair Name="%GovernmentPoliceTitle">Авторитарный</LocalizationPair>
    <LocalizationPair Name="%GovernmentPoliceDescription">Авторитарное правительство — это форма правления сильной центральной власти, которая ценит порядок и контроль над политическими свободами.</LocalizationPair>
