    <LocalizationPair Name="%manpower">10 [happinessColored] for every 200 [manpowerColored]</LocalizationPair>
    <LocalizationPair Name="%manpowerKeii">+5 Bonus [honorColored] gains after every battle for every 200 [manPowerColored]</LocalizationPair>
    <LocalizationPair Name="%lawUpkeep">-25% Law Upkeep Cost</LocalizationPair>
